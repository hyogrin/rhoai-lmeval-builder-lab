# ============================================================
# RHOAI LMEval Builder Lab — Environment Configuration
# ============================================================
# Workbench: Run 0_setup/2_eval_hub_setup.ipynb Step 0
#            — edit values in the cell and run. .env is auto-created.
#
# Local dev: cp sample.env .env && edit .env
# ============================================================

# --- Required: Your OpenShift AI Project ---
NAMESPACE=your-namespace                      # <<< oc project name where model is deployed

# --- Required: Model Deployment Info ---
MODEL_NAME=your-model-name                    # <<< InferenceService name (= served_model_name)
BASE_URL=https://${MODEL_NAME}-predictor.${NAMESPACE}.svc.cluster.local:8443/v1  # <<< KServe internal URL (port 8443 for OAuth)

# --- Required: Hugging Face Token ---
HF_TOKEN=hf_xxxxx                            # <<< your HF token (needed for gated models)
HF_TOKEN_SECRET=hf-token                     #     k8s secret name (default: hf-token)

# --- Model Deployment (0_setup/0_model_deploy.ipynb only) ---
RUNTIME_NAME=vllm-cuda-runtime-gemma4        #     ServingRuntime name
HF_MODEL_ID=google/gemma-4-E2B-it            #     Hugging Face model ID

# --- Evaluation Settings ---
LIMIT=5                                      #     sample limit per benchmark (set higher for full eval)
BATCH_SIZE=8                                 #     batch size for evaluation

# --- EvalHub & MLflow (auto-configured by setup notebooks) ---
EVALHUB_URL=https://localhost:8443            #     auto port-forwarded by notebooks; no need to change
MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc:8443  #  auto-detected from MLflow CR

# ============================================================
# Example: Gemma 4 deployed in "hyo-project" namespace
# ============================================================
# NAMESPACE=hyo-project
# MODEL_NAME=gemma4-e2b-deployment
# BASE_URL=https://gemma4-e2b-deployment-predictor.hyo-project.svc.cluster.local:8443/v1
# HF_TOKEN=hf_your_actual_token
# RUNTIME_NAME=vllm-cuda-runtime-gemma4
# HF_MODEL_ID=google/gemma-4-E2B-it
