# OpenShift AI Configuration
NAMESPACE=your-project
MODEL_NAME=your-model-name
TOKENIZER=google/gemma-2b
BASE_URL=https://<model-predictor>.<namespace>.svc.cluster.local:8443/v1/completions

# Hugging Face Token (required for gated models/tokenizers)
HF_TOKEN=hf_xxxxx

# Evaluation Settings
LIMIT=5
BATCH_SIZE=8
