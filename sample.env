# OpenShift AI Configuration
NAMESPACE=your-project
MODEL_NAME=your-model-deployment-name-in-RHOAI
TOKENIZER=google/gemma-2b
BASE_URL=https://<model-predictor>.<namespace>.svc.cluster.local:8443/v1/completions

# Model Deployment
RUNTIME_NAME=vllm-cuda-runtime-gemma4
HF_MODEL_ID=google/gemma-4-E2B-it
GPU_RESOURCE=nvidia.com/gpu
GPU_COUNT=1

# Hugging Face Token (required for gated models/tokenizers)
HF_TOKEN=hf_xxxxx
HF_TOKEN_SECRET=hf-token

# Evaluation Settings
LIMIT=5
BATCH_SIZE=8

# EvalHub Configuration (see 0_setup/2_eval_hub_setup.ipynb Step A-6 to discover the URL)
EVALHUB_URL=http://evalhub.<namespace>.svc.cluster.local:8080
EVALHUB_AUTH_TOKEN=
MLFLOW_TRACKING_URI=http://mlflow.<namespace>.svc.cluster.local:5000
